<UserControl x:Class="UEManager.UI.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- Header -->
        <Grid Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Game library', Tracked=True}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="{ui:Loc 'My games'}" />
                <Rectangle Width="200" Height="2" Margin="0,14,0,0" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Content="{ui:Loc 'Scan for games'}" ui:Icon.Glyph="&#xE72C;" Command="{Binding ScanGamesCommand}"
                        ToolTip="{ui:Loc 'Finds the games installed through Steam and the Epic Games Launcher'}" />
                <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Add game…'}" ui:Icon.Glyph="&#xE710;"
                        Command="{Binding AddGameCommand}" ToolTip="{ui:Loc 'Choose the folder of a game the scan did not find'}" />
            </StackPanel>
        </Grid>

        <!-- Search, order and count -->
        <TextBox Margin="0,26,0,0" Style="{StaticResource TextBox.Search}" Text="{Binding GameSearch, UpdateSourceTrigger=PropertyChanged}"
                 Tag="{ui:Loc 'Search the games'}" />
        <DockPanel Margin="0,12,0,0">
            <Border DockPanel.Dock="Right" Margin="10,0,0,6" Style="{StaticResource FieldBox}">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding GamesCountText}" />
            </Border>
            <ItemsControl ItemsSource="{Binding GameSortModes}" Focusable="False" ItemTemplate="{StaticResource FilterButton}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>
        <TextBlock Margin="2,2,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap" TextTrimming="None"
                   Text="{ui:Loc 'Click a game to manage its mods. Right-click it to rename it, change its cover or remove it from the list.'}" />

        <!-- No game yet -->
        <StackPanel Margin="0,52" HorizontalAlignment="Center" Visibility="{Binding HasNoGames, Converter={StaticResource Visible}}">
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Title}" Text="{ui:Loc 'No games yet'}" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}"
                       Text="{ui:Loc 'Scan for the games of Steam and Epic, or add a game by its folder.'}" />
        </StackPanel>

        <!-- Games -->
        <ItemsControl Margin="0,22,0,0" ItemsSource="{Binding GamesView}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                    <Border Width="172" Margin="0,0,20,22" Background="Transparent" Cursor="Hand" ToolTip="{Binding Name}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}" />
                        </Border.InputBindings>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{ui:Loc 'Open'}" Command="{Binding OpenCommand}" />
                                <MenuItem Header="{ui:Loc 'Rename…'}" Command="{Binding RenameCommand}" />
                                <MenuItem Header="{ui:Loc 'Change cover…'}" Command="{Binding ChangeCoverCommand}" />
                                <MenuItem Header="{ui:Loc 'Use the store\'s cover'}" Command="{Binding ResetCoverCommand}"
                                          Visibility="{Binding HasCustomCover, Converter={StaticResource Visible}}" />
                                <MenuItem Header="{ui:Loc 'Open game folder'}" Command="{Binding OpenFolderCommand}" />
                                <Separator />
                                <MenuItem Header="{ui:Loc 'Remove from the library'}" Command="{Binding RemoveCommand}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <Grid Height="258">
                                <Border CornerRadius="3" BorderThickness="1" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentBright}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF2A1416" Offset="0" />
                                            <GradientStop Color="#FF121011" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Heading}"
                                                   FontSize="68" Foreground="#38FFFFFF" Text="{Binding Initial}"
                                                   Visibility="{Binding HasCover, Converter={StaticResource Hidden}}" />
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <!-- The game the other pages show. -->
                                <Border Margin="8" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="2"
                                        Background="{StaticResource Brush.Accent}" Visibility="{Binding IsCurrent, Converter={StaticResource Visible}}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.OnAccent}" Text="{ui:Loc 'Open now'}" />
                                </Border>
                            </Grid>
                            <TextBlock Margin="2,10,2,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <TextBlock Margin="2,3,2,0" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding StoreText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding KindText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
